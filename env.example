# Configuration Readeck
READECK_API_URL=https://votre-instance-readeck.com/api
READECK_API_TOKEN=votre_token_readeck

# Configuration Todoist
TODOIST_API_TOKEN=votre_token_todoist
TODOIST_PROJECT_ID=votre_project_id
TODOIST_SECTION_ID=votre_section_id

# Configuration YouTube (optionnelle, laisser vide pour désactiver)
YOUTUBE_PLAYLIST_ID=votre_playlist_id
YOUTUBE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=votre_client_secret
YOUTUBE_REFRESH_TOKEN=obtenu_via_get-youtube-refresh-token.sh
# Section Todoist des vidéos (défaut : TODOIST_SECTION_ID)
YOUTUBE_TODOIST_SECTION_ID=

# Note : Copiez ce fichier en .env et remplissez avec vos vraies valeurs
# cp .env.example .env
